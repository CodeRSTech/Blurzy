shape: sequence_diagram
user: User
win: "Window\n(GUI)"
sh: "SessionHandler\n(GUI)"
svc: "Application + SessionService\n(GUI)"
mgr: "SessionManager\n(GUI)"
dec: "VideoDecodeWorker\n(own QThread)"
user -> win: "File > Open Videos"
win -> sh: "open_videos_requested(paths)"
sh -> svc: "stop_all_playback()"
sh -> svc: "open_videos(paths)"
svc -> mgr: "create_session_from_video_path(path)\nper path"
mgr -> dec: "VideoReader + SessionState,\nthen decode_worker.start()"
mgr -> svc: "SessionAlreadyExists is skipped;\nnone new raises NoNewOpenedSessions"
svc -> mgr: "initialize_active_session()\nif nothing active yet"
svc -> sh: "opened paths"
sh -> sh: "apply preference defaults,\nadopt sessions, hook seek_completed"
sh -> win: "refresh_session_views()\nlist, settings, enable widgets"
dec -> sh: "seek_completed(index)\nsingle shot"
sh -> win: "render first frame"
