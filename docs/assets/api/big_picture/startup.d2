direction: down
main: "src/main.py\nload config, start logging, create QApplication"
app: "Application()" {
  direction: right
  sm: "SessionManager"
  svc: "Services\ndetection, tracking, session, project,\nexport, unified layers"
  io: "Layer import / export services"
}
window: "Window()\nQt main window and panels"
ctl: "UIController(q_app, window, app)" {
  direction: right
