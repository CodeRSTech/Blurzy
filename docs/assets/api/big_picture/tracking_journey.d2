shape: sequence_diagram
user: User
panel: "Right panel"
handler: "TrackingHandler"
facade: "Application"
svc: "TrackingService"
mgr: "TrackingWorkerManager"
worker: "TrackingWorker\n(background)"
store: "Session layers"
user -> panel: "click Start tracking"
panel -> handler: "start_tracking_requested(strategy, source)"
handler -> handler: "validate session; block if\ndetection or tracking is running"
handler -> panel: "show busy state"
handler -> facade: "start_tracking_worker"
facade -> svc: "start_background_tracking"
svc -> mgr: "start(session, strategy, source)"
mgr -> store: "snapshot source layer; clear C and D"
mgr -> worker: "create + start"
handler -> worker: "connect progress / finished / error"
worker -> handler: "progress_updated(current, total)"
handler -> panel: "update progress bar"
worker -> handler: "finished_processing"
handler -> facade: "sync_tracking_cache"
facade -> svc: "sync_tracking_cache"
svc -> store: "write C; seed D"
handler -> panel: "show Tracking tab, redraw preview"
