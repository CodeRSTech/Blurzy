direction: down
ctl: "UIController\nbuilds each handler with itself as the boss"
interact: "Editing and presentation" {
  grid-columns: 1
  annotation: "AnnotationHandler"
  playback: "PlaybackHandler"
  ui: "UIHandler\n(plain class)"
  dialogue: "DialogueHandler"
  prefs: "PreferencesHandler"
}
proc: "Detection and tracking" {
  grid-columns: 1
  detection: "DetectionHandler"
  tracking: "TrackingHandler"
  model: "ModelHandler"
}
sess: "Sessions and projects" {
  grid-columns: 1
  session: "SessionHandler"
  project: "ProjectHandler"
}
exp: "Export and import" {
  grid-columns: 1
  export: "ExportHandler"
  ie: "ImportExportHandler"
}
ctl -> interact
ctl -> proc
ctl -> sess
ctl -> exp
shared: "Shared collaborators\nWindow (widgets, signals) and Application facade" {
  style.stroke-dash: 4
}
interact -> shared: use {style.stroke-dash: 4}
proc -> shared: use {style.stroke-dash: 4}
sess -> shared: use {style.stroke-dash: 4}
exp -> shared: use {style.stroke-dash: 4}
