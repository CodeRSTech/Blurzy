direction: right
h: "AnnotationHandler\nGUI thread"  { style.bold: true; style.stroke-width: 4 }
c: "UIController\n(render only)"
a: "Application facade\nthin delegation"
s: "UnifiedLayerService,\nDetectionLayerService"
m: "SessionManager\n(session lookup)"
i: "Session data store\n(layers A-D)"
h -> c
c -> a
a -> s
s -> m
m -> i
