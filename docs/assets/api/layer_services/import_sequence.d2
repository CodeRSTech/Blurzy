shape: sequence_diagram
user: User
h: "ImportExportHandler\n(GUI thread)"
app: "Application"
svc: "DetectionImportService"
io: "layer_io"
st: "SessionDataStore"
ctl: "UIController"
user -> h: "Import detections: layer B, file, MERGE_REPLACE"
h -> app: "import_layer(s_id, B, path, mode)"
app -> svc: "A/B routes to detection service"
svc -> svc: "coerce; guard layer; file exists?"
svc -> io: "deserialize_layer_from_json/csv"
io -> svc: "{frame: boxes}"
svc -> st: "apply_import_to_layer (data lock)"
svc -> h: "box count"
h -> ctl: "render_frame_for_session_id"
ctl -> user: "boxes redrawn"
h -> user: "status text: Import complete"
