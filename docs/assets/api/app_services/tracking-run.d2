shape: sequence_diagram
ui: "Tracking handler\n(GUI thread)"
svc: "TrackingService"
mgr: "TrackingWorkerManager"
wk: "TrackingWorker\n(QThread)"
rp: "Result processor"
data: "Session data"
ui -> svc: "start_background_tracking(strategy, A or B)"
svc -> mgr: "start()"
mgr -> mgr: "reject if running / source not A,B / source empty"
mgr -> data: "seed missing B frames from A; clear C and D"
mgr -> wk: "create(snapshot of source, settings), start=True"
ui -> wk: "connects progress / finished / failed"
wk -> ui: "finished_processing"
ui -> svc: "sync_tracking_cache()"
svc -> mgr: "get_tracked_data()"
svc -> rp: "overwrite_layer_c()"
rp -> data: "C overwritten; D machine boxes replaced"
