shape: sequence_diagram
ui: "Detection handler\n(GUI thread)"
svc: "DetectionService\n(GUI thread)"
eng: "Engine manager"
wk: "DetectionWorker\n(QThread)"
bp: "Batch processor\n(GUI thread)"
data: "Session data"
ui -> svc: "start_detection_worker_for_session_id"
svc -> svc: "reject if running or no model"
svc -> data: "clear_all_layers()"
svc -> eng: "create_or_update(model)"
svc -> wk: "create + connect batch_ready, progress_updated + start()"
ui -> wk: "connects finished_processing, error_occurred"
wk -> svc: "batch_ready (30 frames)"
svc -> bp: "process_batch"
bp -> data: "A: add boxes, B: replace machine boxes"
wk -> ui: "progress_updated / finished / error"
