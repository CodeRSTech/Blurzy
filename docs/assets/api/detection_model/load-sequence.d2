shape: sequence_diagram
user: "User"
h: "ModelHandler\n(GUI)"
l: "ModelLoadWorker\n(thread)"
s: "DetectionService"
e: "DetectionEngine"
ld: "load_detection_model"
user -> h: "pick YOLOv8n"
h -> user: "warning dialog (keep manual?)"
h -> h: "update_session_settings; spinner on"
h -> l: "start thread"
l -> s: "facade: set_detection_model"
s -> s: "stop old worker; reset_model(layers)"
s -> e: "create or set_model(name)"
e -> ld: "load_detection_model(name)"
ld -> ld: "wrapper loads weights"
l -> h: "finished(s_id, name) or failed(.., err)"
h -> h: "clear boxes tab, status bar, render frame\nor error dialog"
