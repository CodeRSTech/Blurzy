shape: sequence_diagram
user: User
h: "TrackingHandler\n(GUI)"
svc: "TrackingService"
m: "TrackingWorkerManager"
w: "TrackingWorker\n(own thread)"
d: "Session layers"
user -> h: "Run tracking"
h -> svc: "start_tracking_worker (via Application)"
svc -> m: "start(s_id, strategy, source)"
m -> d: "seed B if needed; clear C and D"
m -> w: "create(...) deep-copies input; start()"
h -> w: "connect progress / finished / error"
w -> h: "progress_updated"
w -> h: "finished_processing"
h -> svc: "sync_tracking_cache(s_id)"
svc -> m: "get_tracked_data(s_id)"
m -> w: "get_tracked_data()"
w -> m: "deep copy (under mutex)"
svc -> d: "overwrite C; seed uninitialized D frames"
h -> user: "tracking tab + redraw boxes"
